<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.Controller.DestinationCardController"
      styleClass="destination-card" spacing="10" alignment="CENTER"
      stylesheets="@destination-style.css">
    
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <ImageView fx:id="destinationImage" fitWidth="220" fitHeight="165" 
               preserveRatio="true" styleClass="destination-image"/>

    <VBox alignment="CENTER" spacing="8" styleClass="card-content">
        <Label fx:id="nomLabel" styleClass="card-title" wrapText="true"/>
        <Label fx:id="urlLabel" styleClass="url-label" wrapText="true" maxWidth="200">
            <tooltip>
                <Tooltip fx:id="urlTooltip"/>
            </tooltip>
        </Label>
    </VBox>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="modifierBtn" text="Modifier" styleClass="action-button, edit-button">
            <tooltip>
                <Tooltip text="Modifier cette destination"/>
            </tooltip>
        </Button>
        <Button fx:id="supprimerBtn" text="Supprimer" styleClass="action-button, delete-button">
            <tooltip>
                <Tooltip text="Supprimer cette destination"/>
            </tooltip>
        </Button>
    </HBox>

</VBox> 